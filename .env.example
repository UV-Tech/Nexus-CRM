# =============================================================================
# Required — Supabase (Project Settings -> API)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server only, used by the lead/WhatsApp intake webhooks to
# bypass RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Optional — integration OAuth (enables one-click "Connect" instead of manual
# credential entry). Leave unset to connect providers by pasting credentials.
# =============================================================================
# Facebook + Instagram (Meta) — a registered Meta app
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Google Ads — a Google Cloud OAuth client
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# WhatsApp Business (Meta Cloud API) — presence of a token flips the WhatsApp
# card to one-click connect.
# WHATSAPP_TOKEN=
